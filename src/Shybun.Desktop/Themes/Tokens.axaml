<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Shybun's tokens: ink on paper with the mark's blush, and the reverse in dark mode.
    Text tokens pass WCAG AA (4.5:1) on every Surface token of their theme. Accent is for marks
    and large text only; AccentText is the blush that body text uses.
    The font is the system's, so nothing is bundled.
  -->
  <FontFamily x:Key="SansFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>

  <x:Double x:Key="FontCaption">12</x:Double>
  <x:Double x:Key="FontBody">14</x:Double>
  <x:Double x:Key="FontSubtitle">16</x:Double>
  <x:Double x:Key="FontTitle">20</x:Double>
  <x:Double x:Key="FontDisplay">28</x:Double>

  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>

  <BoxShadows x:Key="Shadow1">0 1 2 0 #1F000000</BoxShadows>
  <BoxShadows x:Key="Shadow2">0 4 12 0 #29000000</BoxShadows>
  <BoxShadows x:Key="Shadow3">0 12 32 0 #33000000</BoxShadows>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Surface1" Color="#FBF8F2" />
      <SolidColorBrush x:Key="Surface2" Color="#F2EDE2" />
      <SolidColorBrush x:Key="Surface3" Color="#E6DFD0" />
      <SolidColorBrush x:Key="Border1" Color="#D6CDBB" />
      <SolidColorBrush x:Key="Text1" Color="#1D1A16" />
      <SolidColorBrush x:Key="Text2" Color="#5C554B" />
      <SolidColorBrush x:Key="Accent" Color="#C4567A" />
      <SolidColorBrush x:Key="AccentHover" Color="#A8456A" />
      <SolidColorBrush x:Key="AccentSubtle" Color="#1FC4567A" />
      <SolidColorBrush x:Key="AccentText" Color="#9C3F62" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Surface1" Color="#14120F" />
      <SolidColorBrush x:Key="Surface2" Color="#1E1B17" />
      <SolidColorBrush x:Key="Surface3" Color="#2A2620" />
      <SolidColorBrush x:Key="Border1" Color="#3A342C" />
      <SolidColorBrush x:Key="Text1" Color="#F2EDE2" />
      <SolidColorBrush x:Key="Text2" Color="#B3AA9C" />
      <SolidColorBrush x:Key="Accent" Color="#F08FB0" />
      <SolidColorBrush x:Key="AccentHover" Color="#F5A9C3" />
      <SolidColorBrush x:Key="AccentSubtle" Color="#26F08FB0" />
      <SolidColorBrush x:Key="AccentText" Color="#F4B3C9" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
